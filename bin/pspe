#!/bin/bash
#
# rspec ラッパースクリプト
# - slotlock(-herdr) で TEST_ENV_NUMBER 用のスロット番号を確保する
#   （排他ロックの保持・空きスロット探索・同時実行禁止は slotlock に委譲）
# - .env.test があれば dotenv(overload) で読み込む（呼び出し側で dotenv を前置き不要）
# - このワークスペースにとって新規確保のスロット(slotlock get が未割り当て)のときだけ
#   DBをフル再構築する(db:rebuild = drop→create→migrate+seed+apartment+initial_data。
#   Rails エンジン(rx_1_core, spec/dummy あり)は spec/dummy に cd して実行、
#   通常アプリ(rx_1/rx_1_batch)はルートで実行。どちらも prefix 無し db:rebuild)。
#   新規確保スロットには別作業の古いDBが残っている可能性があるため確実に作り直す。
# - 再利用スロット(2回目以降)では再構築せず、さらに NO_MIGRATE=true を付けて rspec を
#   起動し、spec の before(:suite) 内の migrate(ridgepole diff が重い)をスキップして高速化する。
#   ※新規確保時に db:rebuild 済みでスキーマ/seed は最新なので migrate 不要。
# - 常時 NO_MIGRATE のため、スキーマ(db/Schemafile)を変更しても再利用スロットでは
#   自動反映されない。スキーマ変更後は PSPE_REBUILD=1 pspe で強制再構築する。
# - rspec は --format RSpec::AiFormatter::Formatter で実行する(gem 'rspec-ai-formatter'
#   導入前提。AI向けにノイズを削った構造化出力でトークンを節約する)。
# - herdr ワークスペースごとに安定したスロット番号が割り当てられ、同じDBを使い回す
#
# スロット番号は slotlock が渡す $SLOT_NUMBER を TEST_ENV_NUMBER として使う。
# 従来挙動に合わせ 2..8 の範囲を使う（slot 1 = 付番なし/開発用DB を避けるため）。

set -eu

# pspe 自体のヘルプ(設定変更に使う環境変数の一覧)。
# 先頭引数が --help / -h のときだけ表示して終了する(rspec には渡さない)。
print_help() {
  cat <<'EOF'
pspe - rspec ラッパー (slotlock で TEST_ENV_NUMBER スロットを確保して実行)

USAGE:
  pspe [rspec への引数...]
  pspe --help | -h

rspec への引数はそのまま rspec に渡される (例: pspe spec/models/foo_spec.rb)。

挙動を変える環境変数:
  PSPE_REBUILD=1
      再利用スロットでも DB をフル再構築してから実行する。
      常時 NO_MIGRATE のためスキーマ(db/Schemafile)変更は自動反映されない。
      スキーマ変更後は PSPE_REBUILD=1 pspe で強制反映する。
      例: PSPE_REBUILD=1 pspe spec/models/foo_spec.rb

  PSPE_MAX_SLOTS=<n>   (既定: 8)
      使用するスロット番号の上限。TEST_ENV_NUMBER の最大値。

  PSPE_MIN_SLOT=<n>    (既定: 2)
      使用するスロット番号の下限。slot 1(付番なし/開発用DB)を避けるため既定は 2。

  KIRO_SESSION_ID (Kiro が自動付与。手動指定は非推奨)
      セットされていると rspec に --format RSpec::AiFormatter::Formatter を付与し、
      AI 向けにノイズを削った構造化出力にする(トークン節約)。
      Kiro 経由以外(人間が直接実行)では付与されず素の出力になる。

その他の挙動(環境変数ではないが関連):
  .env.test / .env.test.local があれば dotenv(overload) で読み込んでから実行する。
  新規確保スロットでは DB を db:rebuild でフル再構築する(古いDB対策)。
  再利用スロットでは再構築せず NO_MIGRATE=true で起動して高速化する。
EOF
}

case "${1:-}" in
  --help | -h)
    print_help
    exit 0
    ;;
esac

MAX_SLOTS="${PSPE_MAX_SLOTS:-8}"
MIN_SLOT="${PSPE_MIN_SLOT:-2}"
DB_BASE_NAME="test_crossxdb"
SCOPE="rspec"

# dotenv 内包:
# カレントに .env.test があれば `bundle exec dotenv -o -f <files>` を prefix として使い、
# rspec / rake を同じ env 下で実行する。Kiro のプロセス環境変数（AWS系など）と
# プロジェクトのテスト用変数のバッティングを防ぐため overload(-o) で上書き優先させる。
# .env.test.local も存在すれば後ろに追加（後勝ちで上書き優先）。
# .env.test が無いプロジェクトでは dotenv を使わずそのまま実行する。
#   DOTENV_PREFIX は空文字 or "bundle exec dotenv -o -f <files> --" が入る。
#   pspe_inner / rebuild_db では `$DOTENV_PREFIX bundle exec ...` のように前置する。
build_dotenv_prefix() {
  if [ ! -f .env.test ]; then
    echo ""
    return
  fi
  local files=".env.test"
  if [ -f .env.test.local ]; then
    files=".env.test,.env.test.local"
  fi
  echo "bundle exec dotenv -o -f ${files} --"
}
DOTENV_PREFIX="$(build_dotenv_prefix)"

# slotlock に実行させる本体。SLOT_NUMBER を slotlock が環境に入れてくれる。
# この関数を export して slotlock-herdr 経由で bash -c から呼び出す。
pspe_inner() {
  local env_num="$SLOT_NUMBER"
  export TEST_ENV_NUMBER="$env_num"

  if [ "$PSPE_NEW_SLOT" = "1" ]; then
    # 新規確保スロット: 古いDBが残っている可能性があるのでフル再構築する。
    rebuild_db "$env_num"
    echo "==> TEST_ENV_NUMBER='${env_num}' で実行します (slot $env_num / 再構築済み)"
  elif [ "${PSPE_REBUILD:-}" = "1" ]; then
    # 再利用スロットだが PSPE_REBUILD=1 指定: スキーマ変更後などに強制再構築する。
    # 常時 NO_MIGRATE のため、スキーマを変えても自動では反映されない。このフラグで反映する。
    rebuild_db "$env_num"
    echo "==> TEST_ENV_NUMBER='${env_num}' で実行します (slot $env_num / 強制再構築)"
  else
    # 再利用スロット: 前回 pspe が db:rebuild 済み。再構築不要。
    echo "==> TEST_ENV_NUMBER='${env_num}' で実行します (slot $env_num / 再利用)"
  fi

  # どの経路でもスキーマ/seed は構築済みなので、rspec 起動時の
  # before(:suite) 内 migrate(ridgepole diff が重い)をスキップして高速化する。
  export NO_MIGRATE="true"

  # rspec-ai-formatter で AI 向けにノイズを削った構造化出力にする(トークン節約)。
  # gem 'rspec-ai-formatter' が導入済みである前提。ユーザーが別の --format を
  # 引数で足した場合は両方のフォーマッタが有効になる(RSpec は複数指定を許容)。
  # Kiro 経由の実行時(KIRO_SESSION_ID がセット済み。Kiro が子プロセスに自動付与)
  # のみ AI 向けフォーマッタを付与する。人間が直接叩いたときは素の出力にする。
  local ai_format=""
  if [ -n "${KIRO_SESSION_ID:-}" ]; then
    ai_format="--format RSpec::AiFormatter::Formatter"
  fi
  # shellcheck disable=SC2086
  $DOTENV_PREFIX bundle exec rspec $ai_format "$@"
}

# 新規確保したスロット、または PSPE_REBUILD=1 指定時に呼ぶ。
# 別作業の古いDBが残っている可能性があるため、DBを drop から作り直して確実に最新化する。
#   db:rebuild(core提供)の中身:
#     db:drop → db:create → migrate_public_schema → seed:plans/tenants
#     → apartmentdb:create → migrate_all_schemas → initial_data:create(各tenant)
#   = spec の before(:suite) 相当のスーパーセット。これで rspec は migrate 不要になる。
# 実行ディレクトリ:
#   - Rails エンジン(rx_1_core。spec/dummy がある)では spec/dummy に cd して実行する。
#     db:rebuild 内部が prefix 無しの rake タスクを Rake::Task[...].invoke で呼ぶため、
#     ルートからの app:db:rebuild では内部タスクが解決できず壊れる(手動運用 rdbrc と同じ理由)。
#   - 通常アプリ(rx_1/rx_1_batch。spec/dummy が無い)ではルートで実行する。
# どちらも prefix 無しの db:rebuild を使う。
# ただし db:rebuild 単体は、DBが既に存在する状態だと内部の drop→create が
# 接続キャッシュの都合で繋がらず migrate_public_schema で「DBが無い」と落ちることがある。
# そのため db:drop db:create を前置してから db:rebuild を呼ぶ(1回のrakeに並べる)。
# これは execute-rspec スキルの実績手順(db:drop db:create db:rebuild)と同じ。
# rake の DB 操作は .env.test のシークレットに依存しない(接続=Settings, DB名=TEST_ENV_NUMBER)
# ため dotenv は通さない。rspec はルートで実行するため、cd はサブシェルに閉じ込める。
rebuild_db() {
  local env_num="$1"
  local run_dir="."
  [ -d spec/dummy ] && run_dir="spec/dummy"
  echo "==> DB '${DB_BASE_NAME}${env_num}' をフル再構築します (${run_dir} で db:rebuild)..."
  (
    cd "$run_dir"
    TEST_ENV_NUMBER="$env_num" RAILS_ENV=test PRIMARY_SERVER=1 \
      bundle exec rake db:drop db:create db:rebuild
  )
  echo "==> DB再構築完了"
}

export -f pspe_inner rebuild_db
export DB_BASE_NAME DOTENV_PREFIX

# 新規確保判定:
# slotlock run を呼ぶ前に get で「このワークスペースに既にslotが割り当て済みか」を見る。
#   get 成功 (割り当て済み) → 再利用 = 前回も自分がこのslotを構築済み → rebuild不要
#   get 失敗 (未割り当て)   → 今回が新規確保 → DBが残っていれば古い可能性があるので rebuild
# get は read-only（ロックも last-used 更新もしない）ため、直後の run の割り当てに影響しない。
# 同じワークスペースなら get で見える番号 = run で確保される番号。
if slotlock-herdr get --scope "$SCOPE" >/dev/null 2>&1; then
  PSPE_NEW_SLOT="0"
else
  PSPE_NEW_SLOT="1"
fi
export PSPE_NEW_SLOT
# ユーザー指定の強制再構築フラグ(スキーマ変更後など)を子 bash へ引き継ぐ。
export PSPE_REBUILD="${PSPE_REBUILD:-}"

# slotlock-herdr が key を $HERDR_WORKSPACE_ID で埋め、slot を確保して
# pspe_inner を実行する。rspec への引数 "$@" はそのまま渡す。
# 子 bash にも set -eu を効かせる(親の set -eu は -c の子シェルに継承されないため)。
# これにより rebuild_db 内の rake 失敗を握りつぶさず、rspec まで進む前に失敗を顕在化させる。
exec slotlock-herdr run --scope "$SCOPE" --min "$MIN_SLOT" --max "$MAX_SLOTS" -- \
  bash -c 'set -eu; pspe_inner "$@"' _ "$@"
