#!/bin/bash
#
# rspec ラッパースクリプト
# - slotlock(-herdr) で TEST_ENV_NUMBER 用のスロット番号を確保する
#   （排他ロックの保持・空きスロット探索・同時実行禁止は slotlock に委譲）
# - 対応するDBが存在しなければ自動で作成＆スキーマロード
# - herdr ワークスペースごとに安定したスロット番号が割り当てられ、同じDBを使い回す
#
# スロット番号は slotlock が渡す $SLOT_NUMBER を TEST_ENV_NUMBER として使う。
# 従来挙動に合わせ 2..8 の範囲を使う（slot 1 = 付番なし/開発用DB を避けるため）。

set -eu

MAX_SLOTS="${PSPE_MAX_SLOTS:-8}"
MIN_SLOT="${PSPE_MIN_SLOT:-2}"
DB_BASE_NAME="test_crossxdb"
SCOPE="rspec"

# DB接続情報（環境変数で上書き可能）
DB_HOST="${RSPEC_DB_HOST:-localhost}"
DB_PORT="${RSPEC_DB_PORT:-5432}"
DB_USER="${RSPEC_DB_USER:-postgres}"
DB_PASSWORD="${RSPEC_DB_PASSWORD:-pstgrsdb}"

# slotlock に実行させる本体。SLOT_NUMBER を slotlock が環境に入れてくれる。
# この関数を export して slotlock-herdr 経由で bash -c から呼び出す。
pspe_inner() {
  local env_num="$SLOT_NUMBER"
  export TEST_ENV_NUMBER="$env_num"

  local db_name="${DB_BASE_NAME}${env_num}"
  if ! check_db_exists "$db_name"; then
    setup_db "$env_num"
  fi

  echo "==> TEST_ENV_NUMBER='${env_num}' で実行します (slot $env_num)"
  bundle exec rspec "$@"
}

check_db_exists() {
  local db_name="$1"
  PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -lqt 2>/dev/null \
    | cut -d'|' -f1 | grep -qw "$db_name"
}

setup_db() {
  local env_num="$1"
  echo "==> DB '${DB_BASE_NAME}${env_num}' が存在しないため作成します..."
  TEST_ENV_NUMBER="$env_num" RAILS_ENV=test bundle exec rake db:create 2>/dev/null || true
  echo "==> スキーマをロードしています (migrate_all_schemas)..."
  # ridgepole方式(db/Schemafile)のため db:schema:load ではなく migrate_all_schemas を使う
  # (public + tenant 両スキーマを構築する。タスクはengine dummy app経由の app: 名前空間)
  TEST_ENV_NUMBER="$env_num" RAILS_ENV=test bundle exec rake app:migrate_all_schemas
  echo "==> DB作成完了"
}

export -f pspe_inner check_db_exists setup_db
export DB_BASE_NAME DB_HOST DB_PORT DB_USER DB_PASSWORD

# slotlock-herdr が key を $HERDR_WORKSPACE_ID で埋め、slot を確保して
# pspe_inner を実行する。rspec への引数 "$@" はそのまま渡す。
exec slotlock-herdr run --scope "$SCOPE" --min "$MIN_SLOT" --max "$MAX_SLOTS" -- \
  bash -c 'pspe_inner "$@"' _ "$@"
